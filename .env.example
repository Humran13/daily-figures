# Copy this file to .env and fill in real values before deploying.
# .env is git-ignored — never commit real secrets to the repository.

# Required. The app refuses to start without this. Generate a real one with:
#   openssl rand -hex 32
SECRET_KEY=

# Only used on the very first-ever startup, when the users table is still
# empty, to create the initial super-administrator account. Required for
# that first boot; safe to leave in place or remove afterwards — they are
# silently ignored once any user account exists.
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=

# Optional. Web Push (real device/browser notifications for Manager/Super
# Admin when a new correction request is submitted, and for an Operator
# when their request is approved/rejected). Entirely optional — the app
# works fully without these; the in-app Requests badge/nav count is the
# guaranteed fallback either way. Generate a real VAPID keypair, e.g. with
# `pip install py-vapid` then `vapid --gen`, or `npx web-push generate-vapid-keys`.
# Never commit real values here — this file only documents the variable
# names.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact URL some push services require in the VAPID claim — a mailto:
# address or an https: URL for this deployment's operator.
VAPID_SUBJECT=mailto:admin@example.com
